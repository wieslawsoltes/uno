		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<Import Project="../targetframework-override-noplatform.props" />
	<Import Project="../Uno.UI.Composition.WebGpu/wgpu-native.targets" />

	<ItemGroup>
		<ProjectReference Include="..\Uno.UI.Composition.ProGpu\Uno.UI.Composition.ProGpu.csproj" AdditionalProperties="ProGPUUseWinRTContracts=false" />
		<ProjectReference Include="..\Uno.WinRT\Uno.WinRT.Reference.csproj" Aliases="unouwp" />
		<ProjectReference Include="..\Uno.Foundation\Uno.Foundation.Reference.csproj" Aliases="unofoundation" />
	</ItemGroup>
</Project>
